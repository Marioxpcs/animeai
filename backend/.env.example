# ─── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/animeai

# ─── Anthropic ──────────────────────────────────────────────────
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ─── App ────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ─── Pipeline ───────────────────────────────────────────────────
# How many anime to enrich per run (keep low while testing)
ENRICH_BATCH_SIZE=10
